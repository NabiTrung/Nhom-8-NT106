## Ignore Visual Studio temporary files, build results, and
## files generated by popular Visual Studio add-ons.
##
## Get latest from https://github.com/github/gitignore/blob/main/VisualStudio.gitignore

# User-specific files
*.rsuser
*.suo
*.user
*.userosscache
*.sln.docstates
*.env
*.userprefs

# Build results
[Dd]ebug/
[Dd]ebugPublic/
[Rr]elease/
[Rr]eleases/
bld/
[Oo]bj/
[Oo]ut/
[Ll]og/
[Ll]ogs/
**/[Bb]in/*
!**/[Bb]in/*.refresh
**/bin/
**/obj/

# Visual Studio
.vs/
Generated\ Files/
*.cache
*.[Cc]ache
*.pdb
*.ilk
*.obj
*.idb
*.iobj
*.pch
*.tmp
*.log
*.tlog
*.vspscc
*.vssscc

# Visual Studio test results
[Tt]est[Rr]esult*/
[Bb]uild[Ll]og.*
*.trx
*.coverage
*.coveragexml

# NuGet
*.nupkg
*.snupkg
**/[Pp]ackages/*
!**/[Pp]ackages/build/

# .NET
project.lock.json
project.fragment.lock.json
artifacts/
.artifacts/

# SQL Server local database files
*.mdf
*.ldf
*.ndf

# Other tools
_ReSharper*/
*.DotSettings.user
node_modules/
__pycache__/
*.pyc
.vscode/*
.history/
*.vsix
*.pfx
*.publishsettings